# Alibaba Cloud Model Studio API key (Singapore/International region).
# Get one from the Model Studio console, then copy this file to `.env`.
DASHSCOPE_API_KEY=sk-your-key-here

# Postgres connection string for the pgvector-backed semantic cache.
DATABASE_URL=postgresql://user:password@localhost:5432/tokentrim

# --- Optional overrides (defaults shown) ---------------------------------
# Endpoint. Default is Singapore/International (matches the pricing table).
# For mainland China use: https://dashscope.aliyuncs.com/compatible-mode/v1
# TOKENTRIM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# TOKENTRIM_EMBED_MODEL=text-embedding-v4
# TOKENTRIM_EMBED_DIM=768
# TOKENTRIM_CACHE_THRESHOLD=0.92
# TOKENTRIM_ROUTER_SIMPLE_MAX=0.35
# TOKENTRIM_ROUTER_MEDIUM_MAX=0.70
# TOKENTRIM_STATS_FILE=tokentrim_stats.jsonl
